# PostgreSQL connection. Any of postgres://, postgresql:// or postgresql+psycopg://
# works - the app converts it to the psycopg v3 driver automatically.
# Neon: use the "pooled" connection string.
# Supabase: use the *pooler* string (Project -> Connect -> Transaction pooler,
# port 6543). Vercel is IPv4-only and Supabase's direct connection is IPv6.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bus_pass_db

# CORS - frontend origin(s) allowed to call the API (comma-separated).
# In production set this to your deployed frontend URL, e.g.
#   ALLOWED_ORIGIN=https://cloudbus-frontend.onrender.com
ALLOWED_ORIGIN=http://localhost:5500

# Protects admin endpoints (create route, list all bookings, cancel).
# Clients send it as an `X-API-Key` header. Leave blank ONLY for local dev;
# in production set a long random value (e.g. `openssl rand -hex 32`).
ADMIN_API_KEY=

# --- Booking confirmation email (optional) ---
# Leave SMTP_HOST blank to skip email sending entirely - bookings still
# work fine without this configured, useful for local testing.
#
# Easiest real option: Gmail with an "App Password" (not your normal
# password - generate one at https://myaccount.google.com/apppasswords,
# requires 2-Step Verification enabled on your Google account first).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=youraddress@gmail.com
#   SMTP_PASSWORD=<the 16-character app password, no spaces>
#   SMTP_FROM_EMAIL=youraddress@gmail.com
#
# No-real-email testing option: Mailtrap.io (free) - gives you an SMTP
# inbox that captures emails without sending them anywhere real, useful
# for confirming the send logic works without spamming a real address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
